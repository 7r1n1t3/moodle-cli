#!/usr/bin/env python3
"""Show open work for your favourited TU Darmstadt Moodle courses.

Token is read from ~/.config/moodle/token.
Usage: moodle-status [--days N]   (look ahead N days, default 21)
"""
import json
import sys
import time
import urllib.parse
import urllib.request
from datetime import datetime
from pathlib import Path

URL = "https://moodle.tu-darmstadt.de/webservice/rest/server.php"
TOKEN = (Path.home() / ".config/moodle/token").read_text().strip()
DAYS = int(sys.argv[sys.argv.index("--days") + 1]) if "--days" in sys.argv else 21
LOOKBACK = 30  # days back to look for overdue items
NOW = int(time.time())


def call(fn, **params):
    data = {"wstoken": TOKEN, "wsfunction": fn, "moodlewsrestformat": "json"}
    for k, v in params.items():
        if isinstance(v, list):
            for i, x in enumerate(v):
                data[f"{k}[{i}]"] = x
        else:
            data[k] = v
    with urllib.request.urlopen(URL, urllib.parse.urlencode(data).encode(), timeout=30) as r:
        res = json.load(r)
    if isinstance(res, dict) and res.get("exception"):
        raise RuntimeError(f"{fn}: {res.get('message')}")
    return res


def when(ts):
    d = datetime.fromtimestamp(ts)
    delta = (ts - NOW) / 86400
    rel = f"in {delta:.0f}d" if delta >= 1 else (f"in {delta*24:.0f}h" if delta >= 0 else f"{-delta:.0f}d ago")
    return f"{d:%a %d.%m %H:%M} ({rel})"


C = sys.stdout.isatty()
def col(s, c): return f"\033[{c}m{s}\033[0m" if C else s
RED, YEL, GRN, DIM, BOLD = "31", "33", "32", "2", "1"

courses = call("core_course_get_enrolled_courses_by_timeline_classification",
               classification="favourites")["courses"]
ids = [c["id"] for c in courses]

# Calendar action events = things Moodle thinks you need to do (submit, attempt, ...)
events = call("core_calendar_get_action_events_by_courses", courseids=ids,
              timesortfrom=NOW - LOOKBACK * 86400, timesortto=NOW + DAYS * 86400, limitnum=50)
ev_by_course = {g["courseid"]: g["events"] for g in events.get("groupedbycourse", [])}

# Assignments with submission status
assigns = {c["id"]: c["assignments"] for c in call("mod_assign_get_assignments", courseids=ids)["courses"]}

total_open = 0
for c in courses:
    name = c["fullname"].split(" - ")[0]
    lines, seen = [], set()

    for a in assigns.get(c["id"], []):
        due = a.get("duedate") or 0
        if not due or not (NOW - LOOKBACK * 86400 <= due <= NOW + DAYS * 86400):
            continue
        seen.update((a["id"], a["cmid"]))
        st = call("mod_assign_get_submission_status", assignid=a["id"])
        sub = (st.get("lastattempt") or {}).get("submission") or {}
        status = sub.get("status", "new")
        graded = (st.get("feedback") or {}).get("gradefordisplay")
        if status == "submitted":
            tag = col("✓ submitted", GRN) + (f", grade: {graded}" if graded else "")
        elif due < NOW:
            tag = col("✗ OVERDUE", RED); total_open += 1
        else:
            tag = col("○ to do" if status == "new" else f"○ {status}", YEL); total_open += 1
        lines.append((due, f"  {tag:<24} {a['name']}  — due {when(due)}"))

    for e in ev_by_course.get(c["id"], []):
        if e.get("modulename") == "assign" and e.get("instance") in seen:
            continue
        act = e.get("action") or {}
        if not act.get("actionable", True):
            continue
        ts = e["timesort"]
        tag = col("✗ OVERDUE", RED) if ts < NOW else col("○ to do", YEL)
        total_open += 1
        label = act.get("name") or e.get("eventtype", "")
        lines.append((ts, f"  {tag:<24} {e['name']} [{e.get('modulename','')}: {label}]  — {when(ts)}"))

    print(col(name, BOLD) + col(f"  ({c['viewurl']})", DIM))
    if lines:
        for _, l in sorted(lines):
            print(l)
    else:
        print(col("  nothing due", DIM))
    print()

print(col(f"{total_open} open item(s) in the next {DAYS} days" if total_open else "All clear 🎉", BOLD))
